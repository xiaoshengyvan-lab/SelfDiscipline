<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:title="自律助手"
        app:titleTextAppearance="@style/TextAppearance.App.Title">

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="设置"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- 中央内容区：圆形表盘垂直水平居中 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- 核心圆形表盘（触碰与反馈均仅限圆内） -->
        <com.selfdiscipline.app.view.CircularTouchLayout
            android:id="@+id/dialContainer"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:background="@drawable/bg_dial"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/ripple_circle">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/ringProgress"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:max="100"
                app:indicatorColor="@color/primary"
                app:indicatorSize="258dp"
                app:trackColor="@color/surface_variant"
                app:trackCornerRadius="3dp"
                app:trackThickness="6dp" />

            <!-- 极简钟表刻度：12 / 3 / 6 / 9 -->
            <View
                android:layout_width="2dp"
                android:layout_height="12dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@color/tick" />

            <View
                android:layout_width="12dp"
                android:layout_height="2dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="24dp"
                android:background="@color/tick" />

            <View
                android:layout_width="2dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@color/tick" />

            <View
                android:layout_width="12dp"
                android:layout_height="2dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="24dp"
                android:background="@color/tick" />

            <!-- 表盘内部三行内容 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDialTask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂无待办"
                    android:textColor="@color/text_label"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvDialCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="点击开始专注"
                    android:textColor="@color/text_primary"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDialHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="点击表盘开始 / 暂停"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.selfdiscipline.app.view.CircularTouchLayout>

        <!-- 权限提示条（仅未授权时显示） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="#FFF8E1"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="需要使用情况访问权限"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="去授权"
                    style="@style/Widget.Material3.Button.TextButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 今日统计 -->
        <TextView
            android:id="@+id/tvTodayStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="今日已完成 0 · 待办 0"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 底部居中：＋ 新增待办（唯一按钮，加大权重） -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:contentDescription="新增待办"
        android:src="@drawable/ic_add"
        app:fabCustomSize="64dp"
        app:maxImageSize="30dp"
        app:tint="@android:color/white" />
</LinearLayout>
